# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/vantage_news

# Environment & Server Settings
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Centralized Authentication & RBAC Dual-Key Rotation
# Public Endpoints (/health, /ready, /metrics, /api/topics): No auth required
# Operator Role (alerts, trending discovery, topic refresh):
OPS_API_KEY=your_primary_ops_api_key_here
OPS_API_KEY_SECONDARY=your_secondary_rotation_ops_api_key_here
# Admin Role (reprocess, database backups, disaster recovery, worker lifecycle, circuit reset):
ADMIN_API_KEY=your_primary_admin_api_key_here
ADMIN_API_KEY_SECONDARY=your_secondary_rotation_admin_api_key_here
# Security Admin Role (audit inspection, retention overrides):
SECURITY_API_KEY=your_primary_security_admin_key_here
SECURITY_API_KEY_SECONDARY=your_secondary_rotation_security_admin_key_here
ENABLE_OPS_CONTROLS=true

# Reddit API Configuration (Optional: fallback to public search if not provided)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=VantageNews/2.0.0 (by /u/your_username)

# OpenAI API Configuration (Embeddings & Perspective Synthesis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_PERSPECTIVE_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# Background Worker & Trending Feed Configuration
TRENDING_W1_VELOCITY=0.35
TRENDING_W2_SOURCES=0.25
TRENDING_W3_ENGAGEMENT=0.25
TRENDING_W4_DECAY=0.15
WORKER_INTERVAL_HOURS=2.0
MIN_TRENDING_SCORE_REFRESH=0.20
STAGNANT_HOURS_THRESHOLD=48.0
DECAY_HALF_LIFE_HOURS=24.0

# Production Monitoring & Alerting Configuration
ENABLE_ALERT_EVALUATION=true
ALERT_WORKER_ENABLED=true
ALERT_COOLDOWN_SECONDS=300
ALERT_DB_LATENCY_THRESHOLD_MS=2000.0
ALERT_WORKER_GRACE_PERIOD_SECONDS=1800
ALERT_SOURCE_STALE_HOURS=24.0
ALERT_PIPELINE_FAILURE_THRESHOLD=2
ALERT_PIPELINE_LATENCY_THRESHOLD_MS=30000.0
ALERT_SOURCE_FAILURE_THRESHOLD=3
ALERT_LLM_FAILURE_THRESHOLD=2
ALERT_X_FAILURE_THRESHOLD=3

# Operational History & Retention Maintenance
OPS_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180

# Database Backup & Disaster Recovery Readiness
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24.0
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_VERIFY_AFTER_CREATE=true
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql

# Distributed Governance & Multi-Worker Coordination (memory | redis)
GOVERNANCE_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
# REDIS_KEY_PREFIX=vantage:gov:
# REDIS_CONNECT_TIMEOUT_MS=500
# REDIS_SOCKET_TIMEOUT_MS=500
# GOVERNANCE_FALLBACK_TO_MEMORY=true
# CONCURRENCY_LEASE_TTL_SECONDS=120

# Rate Limiting Configuration (requests,window_seconds per endpoint)
# RATE_LIMIT_PUBLIC_TOPIC_CREATE=10,60
# RATE_LIMIT_PUBLIC_INGESTION=10,60
# RATE_LIMIT_PUBLIC_MERGE=15,60
# RATE_LIMIT_PUBLIC_CLUSTERING=10,60
# RATE_LIMIT_PUBLIC_SYNTHESIS=5,60
# RATE_LIMIT_PUBLIC_PIPELINE=5,60
# RATE_LIMIT_OPS_TRENDING=5,30
# RATE_LIMIT_OPS_REPROCESS_TOPIC=5,30
# RATE_LIMIT_OPS_BACKUP_CREATE=3,60

# Resource Budget Configuration
BUDGET_MAX_INGESTION_ITEMS_PER_SOURCE=100
BUDGET_MAX_MERGED_ITEMS_PER_TOPIC=5000
BUDGET_MAX_PROCESSING_ITEMS=5000
BUDGET_MAX_EMBEDDING_BATCH_SIZE=100
BUDGET_MAX_EMBEDDINGS_PER_RUN=5000
BUDGET_MAX_CLUSTERS_TO_LLM=10
BUDGET_MAX_SAMPLES_PER_CLUSTER=20
BUDGET_MAX_SYNTHESIS_PER_TOPIC_HOUR=5
BUDGET_MAX_CONCURRENT_PIPELINES=3
BUDGET_MAX_CONCURRENT_SOURCE_CALLS=5
BUDGET_MAX_BACKUP_OPERATIONS=2
BUDGET_MAX_MAINTENANCE_OPERATIONS=2

# Utilization Warning Thresholds (0.0 to 1.0)
RESOURCE_WARNING_THRESHOLD=0.70
RESOURCE_CRITICAL_THRESHOLD=0.90
